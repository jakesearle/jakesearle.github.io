{
  "name": "jakesearle-github-io",
  "version": "1.0.0",
  "private": true,
  "description": "Jake Searle's Garden — a VitePress site of notes and interactive tools",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^1.6.3",
    "vitest": "^4.0.18",
    "vue": "^3.5.17",
    "vue-tsc": "^3.3.9"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vitepress dev",
    "dev:host": "vitepress dev --host",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:test": "node .githooks/personal-info-scan.mjs"
  }
}
