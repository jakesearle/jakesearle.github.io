#!/usr/bin/env bash
# Scans commits being pushed for personal information, and blocks the push if
# any is found. This repo is public and every push to main deploys to the live
# site, so a push is publication.
#
# Image metadata is handled at commit time instead (see pre-commit): stripping
# EXIF means rewriting file content, which only works before the commit exists.
#
# git feeds pre-push one line per ref on stdin:
#     <local_ref> <local_sha> <remote_ref> <remote_sha>
#
# Installed by `npm install` / `npm ci` via the "prepare" script, which runs
# `git config core.hooksPath .githooks`.
set -euo pipefail

remote_name="${1:-origin}"
HOOK_DIR="$(dirname "$0")"
ZERO='0000000000000000000000000000000000000000'

if [ "${SKIP_PII_CHECK:-}" = "1" ]; then
  echo "pre-push: personal-info scan skipped (SKIP_PII_CHECK=1)" >&2
  exit 0
fi

# GUI git clients often run hooks with a minimal PATH that omits node. Fail
# loudly rather than with a bare 127, and block rather than skip the scan.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is required for the personal-information scan but isn't on PATH." >&2
  echo "  If you are pushing from a GUI client, launch it so it inherits your shell PATH," >&2
  echo "  or point this hook at an absolute node path." >&2
  echo "  skip once (not recommended): git push --no-verify" >&2
  exit 1
fi

status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Branch deletion — nothing to inspect.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" != "$ZERO" ]; then
    base="$remote_sha"
  else
    # New branch on the remote. Scan only what the remote does not already
    # have, so a first push reviews genuinely new work rather than all history.
    # tail -n1 is the OLDEST such commit: rev-list emits newest first, and
    # --max-count would truncate before --reverse could help.
    oldest_new=$(git rev-list "$local_sha" --not --remotes="$remote_name" | tail -n1)
    if [ -z "$oldest_new" ]; then
      continue # nothing new to review
    fi
    # Scan from its parent, or the empty tree if it is a root commit.
    base=$(git rev-parse --verify --quiet "${oldest_new}^" ||
      git hash-object -t tree /dev/null)
  fi

  if ! node "$HOOK_DIR/personal-info-scan.mjs" --range "$base" "$local_sha"; then
    status=1
  fi
done

exit "$status"
